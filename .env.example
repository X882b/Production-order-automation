# Security
API_KEY=
MEILI_MASTER_KEY=

# Postgres
PG_DB=
PG_USER=
PG_PASS=
PG_PORT=5432

# API server host
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Host documents directory (absolute path on host)
DOCS_DIR=

# Host user the api/watcher containers run as (`id -u` / `id -g`), default 1000
HOST_UID=1000
HOST_GID=1000

# Optional: the shop's die-code prefixes, comma-separated (e.g. ABC,XYZ).
# When set, the watcher only reads ALATI codes that start with one of them.
STANCNA_PREFIXES=
